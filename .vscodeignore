# ALLOWLIST (t-e1d7): ignore everything, then re-add exactly the files the extension needs at
# runtime. A new top-level file can no longer leak into the .vsix, and a broad ignore pattern can
# no longer silently drop a shipped file. Guarded by scripts/assert-vsix-contents.sh (run by
# `make package` and by release.yml before publish) and by test/packaging.test.js.
**

!package.json
!README.md
!LICENSE

# Extension host: package.json "main" is ./out/extension.js.
!out/**/*.js

# Webview assets — src/webview.ts builds each page's HTML from <page>.{html,css,js}.
!media/board.html
!media/board.css
!media/board.js
!media/sidebar.html
!media/sidebar.css
!media/sidebar.js
!media/codicon/codicon.css
!media/codicon/codicon.ttf

# Icons: package.json "icon" and viewsContainers, plus src/panel.ts's panel tab icon.
!media/loopboard-icon-128.png
!media/icon.svg
!media/icon-dark.svg
!media/icon-light.svg

# Scaffolding templates — src/controller.ts readTemplates() loads these from the installed
# extension for init, auto-heal and Sync Templates. Dropping them breaks the extension at runtime.
!media/template-todo.md
!media/template-loop.md
